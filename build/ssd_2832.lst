 892:Module/ssd_2832.c ****         is_cphy = 0;
 893:Module/ssd_2832.c ****         bridge_select_phy(1);
 894:Module/ssd_2832.c ****     }
 895:Module/ssd_2832.c ****     msleep(50);
 896:Module/ssd_2832.c **** 
 897:Module/ssd_2832.c ****     bridge_hw_reset();
 898:Module/ssd_2832.c **** 
 899:Module/ssd_2832.c **** 	//Set Virtual Channel:
 900:Module/ssd_2832.c **** 	uint32_t virtual_channel = pbridge->virtual_channel;
 901:Module/ssd_2832.c **** 	bridge_write_reg_16bit(0xB8,virtual_channel | (virtual_channel << 2) | (virtual_channel << 4) | (v
 902:Module/ssd_2832.c **** 
ARM GAS  C:\Users\ADMINI~1\AppData\Local\Temp\ccttuXL8.s 			page 64


 903:Module/ssd_2832.c **** 	//PLL power down
 904:Module/ssd_2832.c **** 	bridge_write_reg_16bit(0xB9,0x0000);
 905:Module/ssd_2832.c **** 
 906:Module/ssd_2832.c **** 	//Set PLL, HS=1000Mbps
 907:Module/ssd_2832.c ****     if(is_cphy)
 908:Module/ssd_2832.c ****     {
 909:Module/ssd_2832.c ****         //byp_bit_div = 1, dual symbol clock
 910:Module/ssd_2832.c ****         double sps = (double)(pbridge->clk_hs)/1.0f;
 911:Module/ssd_2832.c ****         hs = (uint32_t)(ceil(sps));
 912:Module/ssd_2832.c ****     }
 913:Module/ssd_2832.c ****     else
 914:Module/ssd_2832.c ****     {
 915:Module/ssd_2832.c ****         double sps = (double)(pbridge->clk_hs)/1.0f;
 916:Module/ssd_2832.c ****         hs = (uint32_t)(ceil(sps));
 917:Module/ssd_2832.c ****     }
 918:Module/ssd_2832.c ****     //XTRAL 25MHZ
 919:Module/ssd_2832.c ****     lp = pbridge->clk_lp;
 920:Module/ssd_2832.c **** 	n = (hs + 4) / 5;
 921:Module/ssd_2832.c **** 	m = 5 * n;
 922:Module/ssd_2832.c **** 	hs = m;
 923:Module/ssd_2832.c **** 
 924:Module/ssd_2832.c **** 	if(is_cphy)
 925:Module/ssd_2832.c ****     {
 926:Module/ssd_2832.c ****         double x = m*1.0/2.0;
 927:Module/ssd_2832.c ****     	n = (uint32_t)(x / (7 * lp));
 928:Module/ssd_2832.c ****     	if ((x - n*7.0f*lp)>0)
 929:Module/ssd_2832.c ****     		n += 1;
 930:Module/ssd_2832.c ****     	lp = (uint32_t)(x / (7 * n));
 931:Module/ssd_2832.c ****     	n -= 1;
 932:Module/ssd_2832.c ****     }
 933:Module/ssd_2832.c ****     else
 934:Module/ssd_2832.c ****     {
 935:Module/ssd_2832.c ****         double x = m*1.0;
 936:Module/ssd_2832.c ****     	n = (uint32_t)(x / (8 * lp));
 937:Module/ssd_2832.c ****     	if ((x - n*8.0f*lp)>0)
 938:Module/ssd_2832.c ****     		n += 1;
 939:Module/ssd_2832.c ****     	lp = (uint32_t)(x / (8 * n));
 940:Module/ssd_2832.c ****     	n -= 1;
 941:Module/ssd_2832.c ****     }
 942:Module/ssd_2832.c **** 
 943:Module/ssd_2832.c **** 	if (m<125)
 944:Module/ssd_2832.c **** 		rba = 0x0200;
 945:Module/ssd_2832.c **** 	else if (m<250)
 946:Module/ssd_2832.c **** 		rba = 0x4200;
 947:Module/ssd_2832.c **** 	else if (m<500)
 948:Module/ssd_2832.c **** 		rba = 0x8200;
 949:Module/ssd_2832.c **** 	else
 950:Module/ssd_2832.c **** 		rba = 0xC200;
 951:Module/ssd_2832.c **** 	rba |= (m / 5) & 0xFF;
 952:Module/ssd_2832.c **** 
 953:Module/ssd_2832.c **** 
 954:Module/ssd_2832.c ****     rba &= 0xf0ff;
 955:Module/ssd_2832.c **** 	rba |= 0x500;
 956:Module/ssd_2832.c **** 
 957:Module/ssd_2832.c ****     bridge_write_reg_16bit(0xBA,rba);
 958:Module/ssd_2832.c **** 
