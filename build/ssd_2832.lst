1397:Module/ssd_2832.c **** /// Description:bridge_send_cmd_image refresh pic ,  CMD screen
1398:Module/ssd_2832.c **** /// @note:
1399:Module/ssd_2832.c **** /// @param input:null
1400:Module/ssd_2832.c **** /// @param output:null
1401:Module/ssd_2832.c **** /// @return value
1402:Module/ssd_2832.c **** ///@author : liuzhiheng
1403:Module/ssd_2832.c **** ///@date : 2019-07-17
1404:Module/ssd_2832.c **** 
1405:Module/ssd_2832.c **** /******************************************************************************/
1406:Module/ssd_2832.c **** int bridge_send_cmd_image(void)
1407:Module/ssd_2832.c **** {
1408:Module/ssd_2832.c **** 	unsigned int tmp = 0 , time_tick = 0;
1409:Module/ssd_2832.c **** 	uint32_t reg_status = 0;
1410:Module/ssd_2832.c **** 		
1411:Module/ssd_2832.c **** 	//Test If is LS NOP Package helps
1412:Module/ssd_2832.c **** 	bridge_send_ls_nop_package();
1413:Module/ssd_2832.c **** 	bridge_send_hs_nop_package();
1414:Module/ssd_2832.c **** 
1415:Module/ssd_2832.c **** 	bridge_write_reg_32bit(0xCF,0X00000000); //SET HS TX TIMER1,L
1416:Module/ssd_2832.c **** 	bridge_write_reg_32bit(0xD0,0X00009000); //SET HS TX TIMER2,H
1417:Module/ssd_2832.c **** 	bridge_write_apb_reg(0X0010,0X1C910E00); //ENABLE V2C
1418:Module/ssd_2832.c **** 
1419:Module/ssd_2832.c **** 	bridge_write_reg_16bit(0xB7,0x030b);
1420:Module/ssd_2832.c **** 	
1421:Module/ssd_2832.c **** 	time_tick = 0;
1422:Module/ssd_2832.c **** 	do
1423:Module/ssd_2832.c **** 	{
1424:Module/ssd_2832.c **** 		bridge_read_reg(0xC6, &reg_status);
1425:Module/ssd_2832.c **** 		if((reg_status & 0x100) == 0)
1426:Module/ssd_2832.c **** 		{
1427:Module/ssd_2832.c **** 			// mcu long buffer is not available
1428:Module/ssd_2832.c **** 			log_info("Err state %x, Reset 2829 inti 4330 \r\n" , reg_status);
1429:Module/ssd_2832.c **** 			break;
1430:Module/ssd_2832.c **** 		}
1431:Module/ssd_2832.c **** 		if((reg_status & 0x200) == 0)
ARM GAS  C:\Users\ADMINI~1\AppData\Local\Temp\ccttuXL8.s 			page 77


1432:Module/ssd_2832.c **** 		{
1433:Module/ssd_2832.c **** 			break;
1434:Module/ssd_2832.c **** 		}
1435:Module/ssd_2832.c **** 		msleep(1);
1436:Module/ssd_2832.c **** 		time_tick++;
1437:Module/ssd_2832.c **** 		if(time_tick > 34)
1438:Module/ssd_2832.c **** 		{
1439:Module/ssd_2832.c **** 			break;
1440:Module/ssd_2832.c **** 		}
1441:Module/ssd_2832.c **** 	}while(1);
1442:Module/ssd_2832.c **** 
1443:Module/ssd_2832.c **** 	bridge_write_reg_16bit(0xB7,0x0300);
1444:Module/ssd_2832.c **** 	
1445:Module/ssd_2832.c **** 	time_tick = 0;
1446:Module/ssd_2832.c **** 	do
1447:Module/ssd_2832.c **** 	{
1448:Module/ssd_2832.c **** 		bridge_read_reg(0xC6, &reg_status);
1449:Module/ssd_2832.c **** 		if((reg_status & 0x200) != 0)
1450:Module/ssd_2832.c **** 		{//bit9
1451:Module/ssd_2832.c **** 			break;
1452:Module/ssd_2832.c **** 		}
1453:Module/ssd_2832.c **** 		if(time_tick > 100)
1454:Module/ssd_2832.c **** 		{//10s
1455:Module/ssd_2832.c **** 			break;
1456:Module/ssd_2832.c **** 		}
1457:Module/ssd_2832.c **** 		msleep(1);
1458:Module/ssd_2832.c **** 		time_tick++;
1459:Module/ssd_2832.c **** 	}while(1);
1460:Module/ssd_2832.c **** 	bridge_write_apb_reg(0X0010,0X1C900E00); //DISABLE V2C
1461:Module/ssd_2832.c **** 
1462:Module/ssd_2832.c **** 	bridge_read_reg(0xC7,&tmp);
1463:Module/ssd_2832.c **** 	
1464:Module/ssd_2832.c **** 	if(tmp != 0)
1465:Module/ssd_2832.c **** 	{
1466:Module/ssd_2832.c **** 		log_info("Err state %x, Reset init \r\n" , reg_status);
1467:Module/ssd_2832.c **** 	}
1468:Module/ssd_2832.c **** 	
1469:Module/ssd_2832.c **** 	return 1;
1470:Module/ssd_2832.c **** }
1471:Module/ssd_2832.c **** 
1472:Module/ssd_2832.c **** int bridge_v2c(unsigned char stage, unsigned int delay)
1473:Module/ssd_2832.c **** {
1474:Module/ssd_2832.c ****     msleep(delay);
1475:Module/ssd_2832.c **** 	
1476:Module/ssd_2832.c ****     if(stage > 0)
1477:Module/ssd_2832.c ****     {
1478:Module/ssd_2832.c ****         if(stage == 1)
1479:Module/ssd_2832.c ****         {
1480:Module/ssd_2832.c ****             bridge_send_hs_nop_package();
1481:Module/ssd_2832.c ****             bridge_write_reg_32bit(0xCF,0x00000000); //SET HS TX TIMER1,L
1482:Module/ssd_2832.c ****             bridge_write_reg_32bit(0xD0,0x00009000); //SET HS TX TIMER2,H
1483:Module/ssd_2832.c ****             bridge_write_reg_16bit(0xB7,0x430B);
1484:Module/ssd_2832.c ****         }
1485:Module/ssd_2832.c **** 
1486:Module/ssd_2832.c ****         if(stage == 2)
1487:Module/ssd_2832.c ****         {
1488:Module/ssd_2832.c ****             bridge_write_apb_reg(0x0010,0x1C910E00); //ENABLE V2C
ARM GAS  C:\Users\ADMINI~1\AppData\Local\Temp\ccttuXL8.s 			page 78


1489:Module/ssd_2832.c ****         }
1490:Module/ssd_2832.c **** 
1491:Module/ssd_2832.c ****         if(stage == 3)
1492:Module/ssd_2832.c ****         {
1493:Module/ssd_2832.c ****             bridge_send_hs_nop_package();
1494:Module/ssd_2832.c ****             bridge_write_reg_32bit(0xCF,0x00000000); //SET HS TX TIMER1,L
1495:Module/ssd_2832.c ****             bridge_write_reg_32bit(0xD0,0x00009000); //SET HS TX TIMER2,H
1496:Module/ssd_2832.c ****             bridge_write_reg_16bit(0xB7,0x430B);
1497:Module/ssd_2832.c ****             msleep(10);
1498:Module/ssd_2832.c ****             bridge_write_apb_reg(0x0010,0x1C910E00); //ENABLE V2C
1499:Module/ssd_2832.c ****         }
1500:Module/ssd_2832.c **** 
1501:Module/ssd_2832.c ****         if(stage == 4)
1502:Module/ssd_2832.c ****         {
1503:Module/ssd_2832.c ****             bridge_write_reg_16bit(0xB7,0x4300);
1504:Module/ssd_2832.c ****             bridge_write_apb_reg(0x0010,0x1C900E00); //DISABLE V2C
1505:Module/ssd_2832.c ****         }
1506:Module/ssd_2832.c **** 
1507:Module/ssd_2832.c ****         if(stage == 5)
1508:Module/ssd_2832.c ****         {}
1509:Module/ssd_2832.c ****     }
1510:Module/ssd_2832.c **** 
1511:Module/ssd_2832.c ****     log_info("stage = %d \n" , stage);
1512:Module/ssd_2832.c **** 	return 1;
1513:Module/ssd_2832.c **** }
1514:Module/ssd_2832.c **** 
