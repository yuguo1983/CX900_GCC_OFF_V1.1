1239:Module/ssd_2832.c **** 	uint32_t rca = (clk_zero << 8) + clk_prepare - 3;
1240:Module/ssd_2832.c **** 	uint32_t rcb = (clk_pre << 8) + clk_post;
1241:Module/ssd_2832.c **** 	uint32_t rcc = (clk_trail << 8) + hs_trail;
1242:Module/ssd_2832.c **** 	uint32_t rdf = hs_exit;
