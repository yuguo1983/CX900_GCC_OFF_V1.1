 711:Module/ssd_2832.c **** /*!*********************************************************************************************
 712:Module/ssd_2832.c ****     Function           :int bridge_check_id(int port)
 713:Module/ssd_2832.c ****     Description        :ssd2832 check id
 714:Module/ssd_2832.c ****     Input Parameter    :
 715:Module/ssd_2832.c ****     Output Parameter   :
 716:Module/ssd_2832.c ****     Who Make it ?      :
 717:Module/ssd_2832.c ****     History            :                            Date/Time:12-03-2013
 718:Module/ssd_2832.c **** *!*********************************************************************************************/
 719:Module/ssd_2832.c **** int bridge_check_id(void)
 720:Module/ssd_2832.c **** {
 721:Module/ssd_2832.c ****     int i = 0;
 722:Module/ssd_2832.c **** 	int retry = 3;
 723:Module/ssd_2832.c ****     uint32_t device_id = 0;
 724:Module/ssd_2832.c **** 
 725:Module/ssd_2832.c **** 
 726:Module/ssd_2832.c **** 	usleep(10000);
 727:Module/ssd_2832.c ****     bridge_hw_reset();
 728:Module/ssd_2832.c ****     for(i = 0; i < retry; i++)
 729:Module/ssd_2832.c ****     {
 730:Module/ssd_2832.c ****         bridge_read_reg(0xB0,&device_id);
 731:Module/ssd_2832.c **** 		log_info("|--mipi bridge,0x%04X\n",device_id);
 732:Module/ssd_2832.c **** 
 733:Module/ssd_2832.c **** 		bridge_read_apb_reg(0x0000,&device_id);
 734:Module/ssd_2832.c **** 		log_info("|--mipi bridge, APB,0x%08X\n",device_id);
 735:Module/ssd_2832.c ****         if(device_id == 0x00002830)
 736:Module/ssd_2832.c ****         {
 737:Module/ssd_2832.c ****             break;
 738:Module/ssd_2832.c ****         }
ARM GAS  C:\Users\ADMINI~1\AppData\Local\Temp\ccttuXL8.s 			page 55


 739:Module/ssd_2832.c ****     }
 740:Module/ssd_2832.c **** 
 741:Module/ssd_2832.c ****     if(i >= retry)
 742:Module/ssd_2832.c ****     {
 743:Module/ssd_2832.c **** 		log_err("fail\n");
 744:Module/ssd_2832.c ****         return -1;
 745:Module/ssd_2832.c **** 	}
 746:Module/ssd_2832.c **** 	return 1;
 747:Module/ssd_2832.c **** }
