1331:Module/ssd_2832.c **** /// Description:bridge_send_hs_nop_package
1332:Module/ssd_2832.c **** /// @note:
1333:Module/ssd_2832.c **** /// @param input:null
1334:Module/ssd_2832.c **** /// @param output:null
1335:Module/ssd_2832.c **** /// @return value
1336:Module/ssd_2832.c **** ///@author : tor shi
1337:Module/ssd_2832.c **** ///@date : 2019-08-26
1338:Module/ssd_2832.c **** /******************************************************************************/
1339:Module/ssd_2832.c **** int bridge_send_hs_nop_package(void)
1340:Module/ssd_2832.c **** {
1341:Module/ssd_2832.c ****     unsigned char data_buff[4] = {0};
1342:Module/ssd_2832.c ****     struct mipi_port mipi;
1343:Module/ssd_2832.c ****     struct bridge *pbridge;
1344:Module/ssd_2832.c **** 	
1345:Module/ssd_2832.c ****     pbridge = bridge_get();
1346:Module/ssd_2832.c **** 
1347:Module/ssd_2832.c ****     mipi.port = 0;
1348:Module/ssd_2832.c ****     if(0 == pbridge->dual) //PORT,single
1349:Module/ssd_2832.c **** 	{
1350:Module/ssd_2832.c ****         mipi.dual = 1;
1351:Module/ssd_2832.c **** 	}
1352:Module/ssd_2832.c **** 	else if(1 == pbridge->dual) //PORT,dual
1353:Module/ssd_2832.c **** 	{
1354:Module/ssd_2832.c **** 	    mipi.dual = 3;
1355:Module/ssd_2832.c **** 	}
1356:Module/ssd_2832.c **** 
1357:Module/ssd_2832.c ****     //Send Packet:0x39,0x00,0x00
1358:Module/ssd_2832.c ****     mipi.video_or_cmd = 0;
1359:Module/ssd_2832.c ****     mipi.data_type    = 0x39;
1360:Module/ssd_2832.c ****     mipi.hs_or_lp     = 1;
1361:Module/ssd_2832.c **** 	
1362:Module/ssd_2832.c ****     data_buff[0] = 0x00;
1363:Module/ssd_2832.c ****     mipi_write_regs(&mipi,data_buff,1);
1364:Module/ssd_2832.c **** 
1365:Module/ssd_2832.c ****     return 1;
1366:Module/ssd_2832.c **** }
1367:Module/ssd_2832.c **** 
