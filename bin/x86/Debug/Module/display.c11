void SetMAXCurrent(u16 vio,u16 vcc,u16 delay,u16 minVIO,u16 minVcc)
{
	u8 i;
	u8 data_xor;
	u8 Buffer[32];
	Buffer[0] = 0x1A;
	Buffer[1] = 0x0b;
	Buffer[2] = 0x04;
	Buffer[3] = vio;
	Buffer[4] = vio>>8;
	Buffer[5] = vcc;
	Buffer[6] = vcc>>8;
	Buffer[7] = delay;
	Buffer[8] = delay>>8;
	Buffer[9] = minVIO;
	Buffer[10] = minVIO>>8;
	Buffer[11] = minVcc;
	Buffer[12] = minVcc>>8;
	Buffer[13] = 0xE5;
	
	data_xor = 0;
	for(i = 0;i<14;i++)
	{
		data_xor ^= Buffer[i];
		UART3_TxChar(Buffer[i]);
	}
	UART3_TxChar(data_xor);
	delay_ms(100);
}
void SetVolCur(void)
{
	switch(gUart3RecBuf[3])
	{
		case 0x01 : IOVCCVoltage = gUart3RecBuf[5];IOVCCVoltage <<= 8;
								IOVCCVoltage += gUart3RecBuf[4];break;
    case 0x02 : IOVCCCurrent = gUart3RecBuf[5];IOVCCCurrent <<=8;
								IOVCCCurrent += gUart3RecBuf[4];break;
	  case 0x03 : LCDVCCVoltage = gUart3RecBuf[5];LCDVCCVoltage <<=8;
								LCDVCCVoltage += gUart3RecBuf[4];break;
		case 0x04 : LCDVCCCurrent = gUart3RecBuf[5];LCDVCCCurrent <<=8;
								LCDVCCCurrent += gUart3RecBuf[4];break;
		case 0x05 : VSPVCCVoltage = gUart3RecBuf[5];VSPVCCVoltage <<=8;
								VSPVCCVoltage += gUart3RecBuf[4];break;
		case 0x06 : VSNVCCVoltage = gUart3RecBuf[5];VSNVCCVoltage <<=8;
								VSNVCCVoltage += gUart3RecBuf[4];break;
		case 0x07 : BLVCCVoltage = gUart3RecBuf[5];BLVCCVoltage <<=8;
								BLVCCVoltage += gUart3RecBuf[4];break;
	}
}
extern unsigned char PowerStatus;
extern unsigned char KeyPowerPressed;
void Uart3Process(void)
{
	unsigned int i;
	unsigned char data_xor;
	unsigned char data_not;
	if(gUart3RecFinish ==1 & gUart3RecLen > 2){
		data_xor = 0;
		for(i = 0; i < gUart3RecLen-1;i++){
			data_xor ^= gUart3RecBuf[i];
		}
		data_not = ~gUart3RecBuf[gUart3RecLen-2];
		if(data_xor == gUart3RecBuf[gUart3RecLen-1] && 
		gUart3RecBuf[0] == data_not)
		{
			if(gUart3RecBuf[0] == 0x1a){
				switch(gUart3RecBuf[1])
				{
					case 0x04 : SetVolCur();break;
					case 0x07 : __disable_irq();
					           iap_load_app(0x08000000);break;
//					case 0x55 :PowerOff_Process();
//										 SetDispColor(WHITE,RED);
//										 SetDispString(9,30," 关 闭 ");
//										 SetDispColor(Yellow1,BLUE);break;
					case 0x55 :if(PowerStatus ==1){
											KeyPowerPressed = 1;
											GPU_Beep(100);
					            delay_ms(100);
					            GPU_Beep(100);
										 }break;
					default : break;
				}
			}
			
		}
		//UART_TxChar(data_xor);
		gUart3RecFinish=0;
	}
}
void USART3_IRQHandler(void) {
  //if(USART_GetFlagStatus(USART1, USART_FLAG_RXNE)) {
	if(USART3->SR & USART_FLAG_RXNE) {
		USART_ClearFlag(USART3, USART_FLAG_RXNE);//清空接收标志位
		Timer4_Enable();
		gUart3RecTimer =3;
		gUart3RecBuf[gUart3RecBufPtr++]=USART3->DR& (uint16_t)0x00FF;
//		UART_TxChar(USART3->DR);
	}
}

void TIM4_IRQHandler(void){                                         
	if(TIM_GetITStatus(TIM4, TIM_IT_Update) != RESET) //检测是否发生溢出更新事件    
	{    
		TIM_ClearITPendingBit(TIM4 , TIM_FLAG_Update); //清除TIM2的中断待处理位
		if(gUart3RecTimer>0){              
				gUart3RecTimer--;                 
		}else {
			  gUart3RecLen=gUart3RecBufPtr;  
			  gUart3RecBufPtr=0;  
			  gUart3RecFinish=1; 
        gUart3RecTimer =3;
  			Timer4_DISABLE();	
		}
  }		
}

typedef  void (*iapfun)(void);				//定义一个函数类型的参数.
iapfun jump2app; 

void iap_load_app(u32 appxaddr)
{
	//如果appxaddr地址处没有应用程序，就不会跳转进去
	if(((*(vu32*)appxaddr)&0x2FFE0000)==0x20000000)	  
	{ 
		jump2app=(iapfun)*(vu32*)(appxaddr+4);				
		jump2app();						
	}
}

