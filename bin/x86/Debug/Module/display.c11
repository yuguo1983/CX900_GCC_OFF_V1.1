#include "display.h"
#include "usart_pc.h"

u8 gUart3RecBuf[640];
unsigned int   gUart3RecBufPtr = 0;// 接收缓冲区指针
unsigned char  gUart3RecTimer  = 0;// 接收数据定时器
unsigned char  gUart3RecFinish = 0;// 接收帧完毕
unsigned char  sUart3SentBusy  = 0;// 接收忙标志
unsigned int   gUart3RecLen	   = 0;// 接收数据长度
extern char Path_Buf[100];

unsigned int   IOVCCVoltage;
unsigned int   IOVCCCurrent;
unsigned int   LCDVCCVoltage;
unsigned int   LCDVCCCurrent;
unsigned int   VSPVCCVoltage;
unsigned int   VSNVCCVoltage;
unsigned int   BLVCCVoltage;
extern unsigned char sdCodeSelect;
void Usart3_Init(u32 SetBaudRate)
{
	//GPIO端口设置
	GPIO_InitTypeDef GPIO_InitStructure;
	USART_InitTypeDef USART_InitStructure;
	 
	RCC_APB1PeriphClockCmd(RCC_APB1Periph_USART3, ENABLE);	//使能USART1，GPIOA时钟
  RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB, ENABLE);
	//USART3_TX   GPIOB.10
	GPIO_InitStructure.GPIO_Pin = GPIO_Pin_10; //PB.10
	GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_InitStructure.GPIO_Mode = GPIO_Mode_AF_PP;	//复用推挽输出
	GPIO_Init(GPIOB, &GPIO_InitStructure);//初始化GPIOA.10
   
	//USART3_RX	  GPIOB.11初始化
	GPIO_InitStructure.GPIO_Pin = GPIO_Pin_11;//PB.11
	GPIO_InitStructure.GPIO_Mode = GPIO_Mode_IN_FLOATING;//浮空输入
	GPIO_Init(GPIOB, &GPIO_InitStructure);//初始化GPIOA.11  


  
	//USART 初始化设置

	USART_InitStructure.USART_BaudRate = SetBaudRate;//串口波特率
	USART_InitStructure.USART_WordLength = USART_WordLength_8b;//字长为8位数据格式
	USART_InitStructure.USART_StopBits = USART_StopBits_1;//一个停止位
	USART_InitStructure.USART_Parity = USART_Parity_No;//无奇偶校验位
	USART_InitStructure.USART_HardwareFlowControl = USART_HardwareFlowControl_None;//无硬件数据流控制
	USART_InitStructure.USART_Mode = USART_Mode_Rx | USART_Mode_Tx;	//收发模式

	USART_Init(USART3, &USART_InitStructure); //初始化串口3
	USART_ITConfig(USART3, USART_IT_RXNE, ENABLE);//开启串口接受中断
	USART_Cmd(USART3, ENABLE);                    //使能串口3 
	Timer4_Configuration();
	Timer4_DISABLE();	
	gUart3RecBufPtr=0;  
	gUart3RecFinish=1; 
	gUart3RecTimer =3;
}

void Timer4_Configuration(void) { //10ms timer
	TIM_TimeBaseInitTypeDef  TIM_TimeBaseStructure;
	
	/* TIM3 clock enable */
	RCC_APB1PeriphClockCmd(RCC_APB1Periph_TIM4, ENABLE);
	TIM_DeInit(TIM4); //复位TIM3定时器, 使之进入初始状态
	
	//---((1+TIM_Prescaler)/(72M or 36M))*(1+TIM_Period)
	TIM_TimeBaseStructure.TIM_Period=20-1;  //自动重装载寄存器的值
	TIM_TimeBaseStructure.TIM_Prescaler=(320); //时钟预分频数
	TIM_TimeBaseStructure.TIM_ClockDivision=TIM_CKD_DIV1;  //采样分频
	TIM_TimeBaseStructure.TIM_CounterMode=TIM_CounterMode_Up; //向上计数模式
	
	TIM_TimeBaseInit(TIM4,&TIM_TimeBaseStructure);
	
	TIM_ClearFlag(TIM4,TIM_FLAG_Update); //清除溢出中断标志
	TIM_ITConfig(TIM4,TIM_IT_Update,ENABLE);
		
  
	//
}

void Timer4_Enable(void) {
	TIM_Cmd(TIM4,ENABLE); //开启时钟
}

void Timer4_DISABLE(void) {
	TIM_Cmd(TIM4,DISABLE); //开启时钟
}
void UART3_TxChar(u8 u8Data)
{
	USART3->DR = (uint16_t)u8Data;	/* Transmit Data */
	while(!(USART3->SR & USART_FLAG_TXE));
}

void SetDispColor(u16 fcolor,u16 bcolor)
{
	u8 i;
	u8 data_xor;
	u8 Buffer[8];
	Buffer[0] = 0x1A;
	Buffer[1] = 0x01;
	Buffer[2] = 0x04;
	Buffer[3] = fcolor;
	Buffer[4] = fcolor>>8;
	Buffer[5] = bcolor;
	Buffer[6] = bcolor>>8;
	Buffer[7] = 0xE5;
	data_xor = 0;
	for(i = 0;i<8;i++)
	{
		data_xor = data_xor ^ Buffer[i];
		UART3_TxChar(Buffer[i]);
	}
	UART3_TxChar(data_xor);
	delay_ms(100);
}

void SetDispString(u16 width,u16 hight,const char *p)
{
	u8 i;
	u8 data_xor;
	u8 Buffer[32];
	Buffer[0] = 0x1A;
	Buffer[1] = 0x02;
	Buffer[2] = 0x04;
	Buffer[3] = width;
	Buffer[4] = width>>8;
	Buffer[5] = hight;
	Buffer[6] = hight>>8;
	data_xor = 0;
	for(i = 0;i<7;i++)
	{
		data_xor ^= Buffer[i];
		UART3_TxChar(Buffer[i]);
	}
	while(*p!='\0'){
		 UART3_TxChar(*p);
		 data_xor ^= *p;
		 p++;
	 }
	UART3_TxChar(0xE5);
	data_xor ^= 0xE5;
	UART3_TxChar(data_xor);
	delay_ms(100);
}

void SetCodeValid(const char *p)
{
	u8 i;
	u8 data_xor;
	u8 Buffer[32];
	Buffer[0] = 0x1A;
	Buffer[1] = 0x09;
	Buffer[2] = 0x04;
	data_xor = 0;
	for(i = 0;i<3;i++)
	{
		data_xor ^= Buffer[i];
		UART3_TxChar(Buffer[i]);
	}
	while(*p!='\0'){
		 UART3_TxChar(*p);
		 data_xor ^= *p;
		 p++;
	 }
	UART3_TxChar(0xE5);
	data_xor ^= 0xE5;
	UART3_TxChar(data_xor);
	delay_ms(100);
}

void SetDispFill(u16 xstart,u16 xend,u16 ystart,u16 yend,u16 color)
{
	u8 i;
	u8 data_xor;
	u8 Buffer[32];
	Buffer[0] = 0x1A;
	Buffer[1] = 0x03;
	Buffer[2] = 0x0A;
	Buffer[3] = xstart;
	Buffer[4] = xstart>>8;
	Buffer[5] = xend;
	Buffer[6] = xend>>8;
	Buffer[7] = ystart;
	Buffer[8] = ystart>>8;
	Buffer[9] = yend;
	Buffer[10] = yend>>8;
	Buffer[11] = color;
	Buffer[12] = color>>8;
	Buffer[13] = 0xE5;
	data_xor = 0;
	for(i = 0;i<14;i++)
	{
		data_xor ^= Buffer[i];
		UART3_TxChar(Buffer[i]);
	}
	UART3_TxChar(data_xor);
	delay_ms(100);
}

void GetVolCur(u8 lane)
{
