	Buffer[0] = 0x1A;
	Buffer[1] = 0x04;
	Buffer[2] = 0x04;
	Buffer[3] = lane;
	Buffer[4] = 0xE5;
	data_xor = 0;
	for(i = 0;i<5;i++)
	{
		data_xor ^= Buffer[i];
		UART3_TxChar(Buffer[i]);
	}
	UART3_TxChar(data_xor);
	delay_ms(100);
}

